<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rr_asphalt">

    <!-- Lienzo del juego: pista, auto del jugador y rivales -->
    <com.racerush.app.ui.race.RaceTrackView
        android:id="@+id/raceTrackView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- HUD superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvLap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hud_chip"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textColor="@color/rr_white"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnQuit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_hud_chip"
            android:contentDescription="@string/pause"
            android:src="@drawable/ic_close" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvPosition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hud_chip"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textColor="@color/rr_yellow"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="76dp"
        android:background="@drawable/bg_hud_chip"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:textColor="@color/rr_white"
        android:textSize="13sp" />

    <!-- Cuenta regresiva 3, 2, 1, ¡YA! -->
    <TextView
        android:id="@+id/tvCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:shadowColor="@color/rr_black"
        android:shadowRadius="8"
        android:textColor="@color/rr_yellow"
        android:textSize="72sp"
        android:textStyle="bold|italic" />

    <!-- Controles de dirección: mantener presionado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnLeft"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:alpha="0.85"
            android:background="@drawable/bg_hud_chip"
            android:contentDescription="@string/steer_left"
            android:scaleType="fitCenter"
            android:padding="12dp"
            android:src="@drawable/ic_steer_left" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_speed_chip"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp"
            android:textColor="@color/rr_dark"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnRight"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:alpha="0.85"
            android:background="@drawable/bg_hud_chip"
            android:contentDescription="@string/steer_right"
            android:scaleType="fitCenter"
            android:padding="12dp"
            android:src="@drawable/ic_steer_right" />
    </LinearLayout>
</FrameLayout>
