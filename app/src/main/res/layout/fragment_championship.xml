<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rr_white"
    android:orientation="vertical">

    <include
        android:id="@+id/header"
        layout="@layout/view_screen_header" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="8dp"
        android:text="@string/championship_season"
        android:textColor="@color/rr_gray_text" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStandings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnJoin"
        style="@style/Widget.RaceRush.Button.Primary"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:text="@string/join_championship" />
</LinearLayout>
