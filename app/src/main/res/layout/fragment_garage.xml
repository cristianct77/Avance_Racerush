<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rr_white"
    android:orientation="vertical">

    <include
        android:id="@+id/header"
        layout="@layout/view_screen_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <!-- Vista previa del auto: carrocería + ruedas (se colorea según el auto) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_car_preview">

            <FrameLayout
                android:id="@+id/carContainer"
                android:layout_width="180dp"
                android:layout_height="64dp"
                android:layout_gravity="center">

                <View
                    android:id="@+id/carBody"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_car_body" />

                <View
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="22dp"
                    android:background="@drawable/bg_wheel" />

                <View
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="22dp"
                    android:background="@drawable/bg_wheel" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/previous_car"
                android:src="@drawable/ic_chevron_left" />

            <TextView
                android:id="@+id/tvCarName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/rr_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/next_car"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCarIndex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/rr_gray_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:text="@string/stat_speed"
                android:textAppearance="@style/TextAppearance.RaceRush.StatLabel" />

            <ProgressBar
                android:id="@+id/pbSpeed"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_weight="1"
                android:max="100"
                android:progressDrawable="@drawable/progress_stat" />

            <TextView
                android:id="@+id/tvSpeed"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/rr_dark"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:text="@string/stat_grip"
                android:textAppearance="@style/TextAppearance.RaceRush.StatLabel" />

            <ProgressBar
                android:id="@+id/pbGrip"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_weight="1"
                android:max="100"
                android:progressDrawable="@drawable/progress_stat" />

            <TextView
                android:id="@+id/tvGrip"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/rr_dark"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:text="@string/stat_boost"
                android:textAppearance="@style/TextAppearance.RaceRush.StatLabel" />

            <ProgressBar
                android:id="@+id/pbBoost"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_weight="1"
                android:max="100"
                android:progressDrawable="@drawable/progress_stat" />

            <TextView
                android:id="@+id/tvBoost"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/rr_dark"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSelectCar"
        style="@style/Widget.RaceRush.Button.Primary"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:text="@string/select_car" />
</LinearLayout>
