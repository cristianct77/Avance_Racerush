<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.racerush.app.ui.splash.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.racerush.app.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment"
            app:enterAnim="@android:anim/slide_in_left"
            app:exitAnim="@android:anim/fade_out" />
        <action
            android:id="@+id/action_login_to_menu"
            app:destination="@id/mainMenuFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.racerush.app.ui.auth.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_register_to_menu"
            app:destination="@id/mainMenuFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/mainMenuFragment"
        android:name="com.racerush.app.ui.menu.MainMenuFragment"
        android:label="Menu"
        tools:layout="@layout/fragment_main_menu">
        <action
            android:id="@+id/action_menu_to_garage"
            app:destination="@id/garageFragment" />
        <action
            android:id="@+id/action_menu_to_championship"
            app:destination="@id/championshipFragment" />
        <action
            android:id="@+id/action_menu_to_settings"
            app:destination="@id/settingsFragment" />
        <action
            android:id="@+id/action_menu_to_notifications"
            app:destination="@id/notificationsFragment" />
    </fragment>

    <fragment
        android:id="@+id/garageFragment"
        android:name="com.racerush.app.ui.garage.GarageFragment"
        android:label="Garage"
        tools:layout="@layout/fragment_garage">
        <argument
            android:name="playFlow"
            android:defaultValue="true"
            app:argType="boolean" />
        <action
            android:id="@+id/action_garage_to_track"
            app:destination="@id/trackSelectFragment" />
    </fragment>

    <fragment
        android:id="@+id/trackSelectFragment"
        android:name="com.racerush.app.ui.track.TrackSelectFragment"
        android:label="Track"
        tools:layout="@layout/fragment_track_select">
        <action
            android:id="@+id/action_track_to_race"
            app:destination="@id/raceFragment" />
    </fragment>

    <fragment
        android:id="@+id/raceFragment"
        android:name="com.racerush.app.ui.race.RaceFragment"
        android:label="Race"
        tools:layout="@layout/fragment_race">
        <action
            android:id="@+id/action_race_to_result"
            app:destination="@id/raceResultFragment"
            app:popUpTo="@id/raceFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/raceResultFragment"
        android:name="com.racerush.app.ui.results.RaceResultFragment"
        android:label="Result"
        tools:layout="@layout/fragment_race_result">
        <action
            android:id="@+id/action_result_to_race"
            app:destination="@id/raceFragment"
            app:popUpTo="@id/raceResultFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_result_to_championship"
            app:destination="@id/championshipFragment"
            app:popUpTo="@id/mainMenuFragment" />
    </fragment>

    <fragment
        android:id="@+id/championshipFragment"
        android:name="com.racerush.app.ui.championship.ChampionshipFragment"
        android:label="Championship"
        tools:layout="@layout/fragment_championship">
        <action
            android:id="@+id/action_championship_to_join"
            app:destination="@id/joinChampionshipFragment" />
    </fragment>

    <fragment
        android:id="@+id/joinChampionshipFragment"
        android:name="com.racerush.app.ui.championship.JoinChampionshipFragment"
        android:label="Join"
        tools:layout="@layout/fragment_join_championship" />

    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.racerush.app.ui.notifications.NotificationsFragment"
        android:label="Notifications"
        tools:layout="@layout/fragment_notifications" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.racerush.app.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settings_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>
